{
  "name": "siglent-sdg-mcp",
  "version": "2.0.3",
  "description": "MCP server for Siglent SDG waveform generator control via SCPI over TCP sockets",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "siglent-sdg-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "hardware-check": "npm run build && node scripts/hardware-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "siglent",
    "waveform-generator",
    "scpi"
  ],
  "author": "Magnus Johansson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagnusJohansson/siglent-sdg-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
